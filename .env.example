# Copy to .env locally (never commit .env). HS256 key must be >= 32 characters.
TAYJAVA_JWT_SECRET=replace-with-openssl-rand-base64-32

# OAuth2 Login (lesson 28) — placeholders only; set real values from Google/GitHub consoles.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

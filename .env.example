# Copy to .env locally (never commit .env). HS256 key must be >= 32 characters.
TAYJAVA_JWT_SECRET=replace-with-openssl-rand-base64-32

# OAuth2 Login (lesson 28) — placeholders only; set real values from Google/GitHub consoles.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resource Server external issuer (lesson 29 profile: external-jwt)
TAYJAVA_JWT_ISSUER_URI=http://localhost:8081/realms/tayjava
TAYJAVA_JWT_AUDIENCE=tayjava-api

# Opaque introspection (lesson 29 profile: opaque) — optional
TAYJAVA_INTROSPECTION_URI=
TAYJAVA_INTROSPECTION_CLIENT_ID=
TAYJAVA_INTROSPECTION_CLIENT_SECRET=

# Lab-only MFA OTP (lesson 32); never a production authenticator secret
TAYJAVA_MFA_LAB_CODE=123456
